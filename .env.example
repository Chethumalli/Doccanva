# DocuCanvas Environment Configuration

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/docucanvas

# Authentication (NextAuth / Auth.js)
# Generated with `openssl rand -base64 32`
AUTH_SECRET=your_nextauth_secret_key_at_least_32_characters_long
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# AI Assistant (Google Gemini API)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Caching & Rate Limiting (Redis - Optional: falls back to in-memory cache)
# Upstash or local Redis: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Email Service (Nodemailer / SMTP - Optional: logs to console if not configured)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM="DocuCanvas <noreply@docucanvas.com>"

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
